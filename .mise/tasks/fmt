#!/usr/bin/env bash
#MISE description="Format code"
#USAGE flag "-c --check" help="Check formatting without making changes"
set -e

args=()
if [ "${usage_check:-false}" = "true" ]; then
  args+=(-- --check)
fi

cargo fmt "${args[@]}"
# ishikari-wasm is a workspace of its own (it needs a newer Rust).
cargo fmt --manifest-path ishikari-wasm/Cargo.toml "${args[@]}"
