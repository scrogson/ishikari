#!/usr/bin/env bash
#MISE description="Publish the crates to crates.io (macros, ishikari, CLI, admin, in dependency order)"
#USAGE flag "-n --dry-run" help="Package and verify without publishing"
set -e

args=(--workspace)
if [ "${usage_dry_run:-false}" = "true" ]; then
  args+=(--dry-run --allow-dirty)
fi

cargo publish "${args[@]}"
