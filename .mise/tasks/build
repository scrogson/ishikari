#!/usr/bin/env bash
#MISE description="Build all crates"
#USAGE flag "-r --release" help="Build in release mode"
set -e

args=()
if [ "${usage_release:-false}" = "true" ]; then
  args+=(--release)
fi

cargo build "${args[@]}"
# ishikari-wasm is a workspace of its own (it needs a newer Rust).
cargo build --manifest-path ishikari-wasm/Cargo.toml "${args[@]}"
