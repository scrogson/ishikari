{
  "name": "ishikari-admin-styles",
  "private": true,
  "scripts": {
    "build": "npm run build:standalone && npm run build:embed",
    "build:standalone": "tailwindcss -i ./admin.css -o ../assets/admin.css --minify",
    "build:embed": "tailwindcss -i ./admin-embed.css -o ../assets/admin-embed.css --minify",
    "watch": "tailwindcss -i ./admin.css -o ../assets/admin.css --watch & tailwindcss -i ./admin-embed.css -o ../assets/admin-embed.css --watch & wait"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.47",
    "tailwindcss": "^4.3.3"
  }
}
